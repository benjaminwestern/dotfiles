{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "engram_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "terraform_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "google-developer-knowledge_*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "providers": {
    "openai": {
      "models": {
        "daybreak-blue": {
          "modelID": "gpt-daybreak-blue-latest",
          "name": "Daybreak Blue",
          "disabled": false
        }
      }
    }
  },
  "plugins": [
    "./plugins/mise",
    "./plugins/engram",
    "-mise.environment.v1",
    "-engram.lifecycle.v1"
  ],
  "mcp": {
    "servers": {
      "google-developer-knowledge": {
        "type": "remote",
        "url": "https://developerknowledge.googleapis.com/mcp",
        "headers": {
          "X-Goog-Api-Key": "{env:GOOGLE_MCP_DEV_SERVER_API_KEY}"
        },
        "oauth": false,
        "disabled": false
      },
      "terraform": {
        "type": "local",
        "command": [
          "terraform-mcp-server"
        ],
        "disabled": false
      },
      "engram": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "github:Gentleman-Programming/engram@2.0.0-rc.10",
          "--",
          "engram",
          "mcp",
          "--tools=agent"
        ],
        "environment": {
          "ENGRAM_CLOUD_AUTOSYNC": "0"
        },
        "disabled": false
      }
    }
  }
}
