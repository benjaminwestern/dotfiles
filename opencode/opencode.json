{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "tools": {
    "bash": true,
    "edit": true,
    "write": true,
    "read": true,
    "grep": true,
    "glob": true,
    "list": true,
    "patch": true,
    "todowrite": true,
    "todoread": true,
    "webfetch": true,
    "websearch": true
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "providers": {
    "openai": {
      "models": {
        "daybreak-blue": {
          "modelID": "gpt-daybreak-blue-latest",
          "name": "Daybreak Blue"
        }
      }
    }
  },
  "plugins": [
    "./plugins/mise",
    "./plugins/engram",
    "-mise.environment.v1",
    "-engram.lifecycle.v1"
  ],
  "mcp": {
    "google-developer-knowledge": {
      "type": "remote",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:GOOGLE_MCP_DEV_SERVER_API_KEY}"
      },
      "enabled": true
    },
    "terraform": {
      "type": "local",
      "command": [
        "terraform-mcp-server"
      ],
      "enabled": true
    },
    "engram": {
      "command": [
        "mise",
        "exec",
        "github:Gentleman-Programming/engram@2.0.0-rc.10",
        "--",
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local",
      "environment": {
        "ENGRAM_CLOUD_AUTOSYNC": "0"
      }
    }
  }
}
