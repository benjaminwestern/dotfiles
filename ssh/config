# Ona CLI SSH Integration
Include "ona/config"
# End of Ona CLI SSH Integration
Host bitbucket.org
   HostName bitbucket.org
   IdentityFile ~/.ssh/id_rsa
   IdentitiesOnly yes

Host bitbucket-org1
  HostName bitbucket.org
  IdentityFile ~/.ssh/bitbucket-key
  IdentitiesOnly yes

Host github.com 
   HostName github.com
   IdentityFile ~/.ssh/id_rsa
   IdentitiesOnly yes

Host family-tunnel
  HostName 192.168.4.4
  User benjaminwestern
  LocalForward localhost:3389 10.0.0.53:3389
  IdentityFile ~/.ssh/id_rsa

Host macbook-air macbook-air.home.arpa
  HostName macbook-air.home.arpa
  User benjaminwestern

Host mac-mini mac-mini.home.arpa
  HostName mac-mini.home.arpa
  User benjaminwestern
  IdentityFile ~/.ssh/id_rsa
  IdentitiesOnly yes
  RequestTTY yes

Host cachy cachy.home.arpa
  HostName cachy.home.arpa
  User benjaminwestern
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host pi5
  HostName pi5.local
  User benjaminwestern
  IdentityFile ~/.ssh/id_rsa
  RequestTTY yes
  SetEnv TERM=xterm-256color

Host zero 
  HostName zero.local
  User benjaminwestern
  IdentityFile ~/.ssh/id_rsa

Host tv-zero 
  HostName tv-zero.local
  User benjaminwestern
  IdentityFile ~/.ssh/id_rsa

Host usb-zero 
  HostName usb-zero.local
  User benjaminwestern
  IdentityFile ~/.ssh/id_rsa

Match Host pi4-*
  User benjaminwestern
  IdentityFile ~/.ssh/id_rsa

# 1Password SSH agent: use the platform's Unix socket when it exists.
# Windows OpenSSH uses 1Password's fixed named pipe and needs no entry here.
Match exec "test -S $HOME/.1password/agent.sock"
  IdentityAgent ~/.1password/agent.sock

Match exec "test -S \"$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\""
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
